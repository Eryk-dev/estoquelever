# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime logs
logs.txt

# misc files (not part of the project)
_misc/

# ralph runtime state
scripts/ralph/.last-branch

# env files (can opt-in for committing if needed)
.env*
!.env.test
!.env.example

# test harness reports (gitignored, never committed)
/scripts/wms/cenarios/reports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Cloned reference repo (not part of SISO source) — anchored to top-level only
/cross/
