NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── WMS Cutover (Plano 2) flags ───────────────────────────────────────────
# TINY_DISABLED: when true, all calls to Tiny ERP are stubbed locally
# (reads from siso_* tables, writes return fake IDs and no-op). Required
# for staging without Tiny credentials. Default false in prod.
TINY_DISABLED=false

# WMS_AS_SOURCE: when true, webhook-processor reads stock from siso_estoque
# (not Tiny), and execution-worker writes via wms_inserir_movimentacao
# (not lancarEstoqueNota / movimentarEstoque). Default false in prod.
WMS_AS_SOURCE=false

# WORKER_SECRET: protects POST /api/worker/processar
WORKER_SECRET=change-me
